# Example systemd timer for the AH bot: runs it every 30 seconds (owner's choice - fast catalog
# fill-in and quick buyouts; once the AH is fully stocked most runs are cheap no-ops since nothing is
# missing). Install as /etc/systemd/system/ah-bot.timer, alongside ah-bot.service.

[Unit]
Description=Run the FFXI Auction House bot every 30 seconds

[Timer]
OnBootSec=5sec
OnUnitActiveSec=30sec

[Install]
WantedBy=timers.target
